# Variables para docker compose (VPS). Copiar a .env en la raíz del repo y cambiar los valores.

# Dominio con el registro DNS A apuntando al VPS -> HTTPS automático con Caddy.
# Vacío -> HTTP por IP en PUERTO_WEB (sin HTTPS no funciona VR/WebXR).
DOMINIO=

# Puerto público del juego en modo HTTP. Con DOMINIO se usa solo en 127.0.0.1 (depuración); (por defecto 8080).
PUERTO_WEB=8080

# Jugadores simultáneos por sala y conexiones por IP.
MAX_PLAYERS=12
MAX_PER_IP=4
